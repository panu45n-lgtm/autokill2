--// TOGGLE SYSTEM
local states = {
    auto1 = false,
    auto2 = false,
    auto3 = false,
    auto4 = false,
    auto5 = false
}

local function SetToggle(offButton, onButton, stateName, enabled)
    states[stateName] = enabled
    getgenv()[stateName] = enabled

    offButton.Visible = not enabled
    onButton.Visible = enabled
end

local function BindToggle(offButton, onButton, stateName, callback)
    offButton.MouseButton1Click:Connect(function()
        SetToggle(offButton, onButton, stateName, true)
        if callback then
            callback()
        end
    end)

    onButton.MouseButton1Click:Connect(function()
        SetToggle(offButton, onButton, stateName, false)
    end)
end

--// AUTO EQUIP WEIGHT
BindToggle(Off1, On1, "auto1", function()
    task.spawn(function()
        while states.auto1 do
            local character = Player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local tool = Player.Backpack:FindFirstChild("Weights")

            if humanoid and tool then
                humanoid:EquipTool(tool)
            end

            task.wait(0.1)
        end
    end)
end)

