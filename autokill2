--// AUTO KILL ALL
BindToggle(Off5, On5, "auto5", function()
    task.spawn(function()
        while states.auto5 do
            local character = Player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local myRoot = character and character:FindFirstChild("HumanoidRootPart")

            if humanoid and myRoot then
                local stompTool = Player.Backpack:FindFirstChild("Stomp")

                if stompTool then
                    humanoid:EquipTool(stompTool)
                end

                local stomp = character:FindFirstChild("Stomp")
                local event = stomp and stomp:FindFirstChild("E")

                if event then
                    event:FireServer()
                end

                -- ไม่เลือกตัวเราเอง
                -- ระยะด้านหน้า 3 studs
                for _, targetPlayer in ipairs(Players:GetPlayers()) do
                    if targetPlayer ~= Player then
                        local targetCharacter = targetPlayer.Character
                        local targetRoot = targetCharacter
                            and targetCharacter:FindFirstChild("HumanoidRootPart")

                        if targetRoot then
                            targetRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -6)
                        end
                    end
