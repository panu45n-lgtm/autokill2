--// AUTO KILL EVIL TEACHER
BindToggle(Off4, On4, "auto4", function()
    task.spawn(function()
        while states.auto4 do
            task.spawn(function()
                local character = Player.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                local root = character and character:FindFirstChild("HumanoidRootPart")
                local tool = Player.Backpack:FindFirstChild("Fight")
                local teacher = workspace:FindFirstChild("Evil Teacher")

                if humanoid and root and tool and teacher then
                    local oldPosition = root.CFrame
                    humanoid:EquipTool(tool)

                    task.wait()

                    local fight = character:FindFirstChild("Fight")
                    local event = fight and fight:FindFirstChild("E")

                    if event then
                        event:FireServer()
                    end

                    local hair = teacher:FindFirstChild("Accessories")
                        and teacher.Accessories:FindFirstChild("Hair")

                    if hair then
                        root.CFrame = hair.CFrame
                        task.wait(0.1)
                        root.CFrame = oldPosition
                    end
                end
            end)

            task.wait(3)
        end
    end)
